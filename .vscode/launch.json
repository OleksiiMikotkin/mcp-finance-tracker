{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run MCP Server (HTTP)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Mcp.FinanceTracker.Server/bin/Debug/net10.0/Mcp.FinanceTracker.Server.dll",
      "cwd": "${workspaceFolder}/Mcp.FinanceTracker.Server",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5094"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
